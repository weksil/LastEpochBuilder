[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/trees/node_tooltip.gd" id="1_script"]
[ext_resource type="Theme" path="res://theme/main_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/trees/node_tooltip_stat.tscn" id="3_stat"]

[node name="NodeTooltip" type="VBoxContainer"]
custom_minimum_size = Vector2(360, 0)
theme = ExtResource("2_theme")
theme_override_constants/separation = 4
script = ExtResource("1_script")
stat_scene = ExtResource("3_stat")

[node name="Title" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Node"

[node name="Points" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Points: 0/1"

[node name="Description" type="Label" parent="."]
