[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/calcs/buffs_panel.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/calcs/buff_skill_row.tscn" id="2_row"]

[node name="BuffsPanel" type="PanelContainer"]
theme_type_variation = &"SectionCard"
script = ExtResource("1_script")
row_scene = ExtResource("2_row")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"SectionTitle"
text = "Баффы умений на персонажа"

[node name="Hint" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Умения на панели усиливают персонажа, а значит и все остальные умения и «Характеристики». Галочка включает или выключает бафф."
autowrap_mode = 3

[node name="List" type="VBoxContainer" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4
