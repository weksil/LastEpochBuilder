[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/calcs/calc_row.gd" id="1_script"]

[node name="CalcRow" type="PanelContainer"]
theme_type_variation = &"CalcRow"
script = ExtResource("1_script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Line" type="HBoxContainer" parent="VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ExpandButton" type="Button" parent="VBox/Line"]
unique_name_in_owner = true
custom_minimum_size = Vector2(26, 0)
layout_mode = 2
focus_mode = 0
toggle_mode = true
text = "+"
flat = true

[node name="NameLabel" type="Label" parent="VBox/Line"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
text = "Показатель"
autowrap_mode = 3

[node name="ValueLabel" type="Label" parent="VBox/Line"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"ValueLabel"
text = "0"
horizontal_alignment = 2

[node name="DetailsPanel" type="PanelContainer" parent="VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"BreakdownPanel"

[node name="Details" type="Label" parent="VBox/DetailsPanel"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BreakdownLabel"
autowrap_mode = 3
