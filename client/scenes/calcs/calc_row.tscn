[gd_scene format=3]

[node name="CalcRow" type="VBoxContainer"]
theme_override_constants/separation = 0

[node name="Line" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ExpandButton" type="Button" parent="Line"]
unique_name_in_owner = true
custom_minimum_size = Vector2(26, 0)
layout_mode = 2
focus_mode = 0
toggle_mode = true
text = "+"
flat = true

[node name="NameLabel" type="Label" parent="Line"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(120, 0)
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
text = "Показатель"
autowrap_mode = 3

[node name="ValueLabel" type="Label" parent="Line"]
unique_name_in_owner = true
layout_mode = 2
text = "0"
horizontal_alignment = 2

[node name="Details" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"BreakdownLabel"
autowrap_mode = 3
