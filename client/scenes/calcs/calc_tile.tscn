[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/calcs/calc_tile.gd" id="1_script"]

[node name="CalcTile" type="PanelContainer"]
theme_type_variation = &"TilePanel"
script = ExtResource("1_script")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Caption" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeroCaption"
text = "Metric"
autowrap_mode = 3

[node name="Value" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeroValue"
text = "—"
clip_text = true

[node name="Sub" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = ""
autowrap_mode = 3
