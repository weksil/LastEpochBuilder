[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/calcs/calcs_tab.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/calcs/calc_section.tscn" id="2_section"]
[ext_resource type="PackedScene" path="res://scenes/calcs/calc_row.tscn" id="3_row"]
[ext_resource type="PackedScene" path="res://scenes/calcs/skill_input_row.tscn" id="4_input_row"]
[ext_resource type="PackedScene" path="res://scenes/calcs/calc_summary.tscn" id="5_summary"]
[ext_resource type="PackedScene" path="res://scenes/calcs/buffs_panel.tscn" id="6_buffs"]
[ext_resource type="PackedScene" path="res://scenes/calcs/calc_notes.tscn" id="7_notes"]

[node name="Calculations" type="VBoxContainer"]
theme_override_constants/separation = 8
script = ExtResource("1_script")
section_scene = ExtResource("2_section")
row_scene = ExtResource("3_row")
input_row_scene = ExtResource("4_input_row")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SkillLabel" type="Label" parent="Header"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Skill"

[node name="SkillSelect" type="OptionButton" parent="Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 0)
layout_mode = 2
focus_mode = 0

[node name="Hint" type="Label" parent="Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
text = "\"+\" expands the breakdown of the number · changed values are highlighted"
autowrap_mode = 3
horizontal_alignment = 2

[node name="Summary" parent="." instance=ExtResource("5_summary")]
unique_name_in_owner = true
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Sections" type="VBoxContainer" parent="Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="ParamsPanel" type="PanelContainer" parent="Scroll/Sections"]
layout_mode = 2
theme_type_variation = &"SectionCard"

[node name="ParamsContent" type="VBoxContainer" parent="Scroll/Sections/ParamsPanel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="ParamsTitle" type="Label" parent="Scroll/Sections/ParamsPanel/ParamsContent"]
layout_mode = 2
theme_type_variation = &"SectionTitle"
text = "Calculation parameters"

[node name="ParamsHint" type="Label" parent="Scroll/Sections/ParamsPanel/ParamsContent"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "These are your assumptions about the fight. Change the values: the numbers below and in the \"Stats\" update at once."
autowrap_mode = 3

[node name="Inputs" type="GridContainer" parent="Scroll/Sections/ParamsPanel/ParamsContent"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 24
theme_override_constants/v_separation = 6
columns = 2

[node name="HitsRow" type="HBoxContainer" parent="Scroll/Sections/ParamsPanel/ParamsContent/Inputs"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="HitsLabel" type="Label" parent="Scroll/Sections/ParamsPanel/ParamsContent/Inputs/HitsRow"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_horizontal = 3
text = "Hits on the target per use"
autowrap_mode = 3

[node name="HitsSpin" type="SpinBox" parent="Scroll/Sections/ParamsPanel/ParamsContent/Inputs/HitsRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
max_value = 50.0
step = 0.1
value = 1.0
update_on_text_changed = true

[node name="Buffs" parent="Scroll/Sections" instance=ExtResource("6_buffs")]
unique_name_in_owner = true
layout_mode = 2

[node name="Columns" type="HBoxContainer" parent="Scroll/Sections"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Left" type="VBoxContainer" parent="Scroll/Sections/Columns"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Right" type="VBoxContainer" parent="Scroll/Sections/Columns"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Wide" type="VBoxContainer" parent="Scroll/Sections"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Notes" parent="Scroll/Sections/Wide" instance=ExtResource("7_notes")]
unique_name_in_owner = true
layout_mode = 2
