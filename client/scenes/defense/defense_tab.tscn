[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/defense/defense_tab.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/calcs/calc_section.tscn" id="2_section"]
[ext_resource type="PackedScene" path="res://scenes/calcs/calc_row.tscn" id="3_row"]
[ext_resource type="PackedScene" path="res://scenes/calcs/calc_tile.tscn" id="4_tile"]
[ext_resource type="PackedScene" path="res://scenes/calcs/calc_notes.tscn" id="5_notes"]
[ext_resource type="PackedScene" path="res://scenes/common/search_select.tscn" id="6_search"]

[node name="Defense" type="VBoxContainer"]
theme_override_constants/separation = 8
script = ExtResource("1_script")
section_scene = ExtResource("2_section")
row_scene = ExtResource("3_row")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="AttackLabel" type="Label" parent="Header"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Enemy attack"

[node name="GroupSelect" parent="Header" instance=ExtResource("6_search")]
unique_name_in_owner = true
custom_minimum_size = Vector2(340, 0)
layout_mode = 2

[node name="AttackSelect" parent="Header" instance=ExtResource("6_search")]
unique_name_in_owner = true
custom_minimum_size = Vector2(320, 0)
layout_mode = 2

[node name="Hint" type="Label" parent="Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
text = "Average monster of a level 100 monolith, end bosses of the timelines, pinnacle bosses · \"+\" expands the breakdown"
autowrap_mode = 3
horizontal_alignment = 2

[node name="Summary" type="PanelContainer" parent="."]
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Summary"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Head" type="HBoxContainer" parent="Summary/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="AttackTitle" type="Label" parent="Summary/VBox/Head"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TitleLabel"
text = "Attack"
clip_text = true
text_overrun_behavior = 3

[node name="ContextLabel" type="Label" parent="Summary/VBox/Head"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
horizontal_alignment = 2

[node name="OneShotLabel" type="Label" parent="Summary/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"NoSourceLabel"
text = "The worst hit of this attack (crit, +20% variance, no dodge or block) kills you from full health"
autowrap_mode = 3

[node name="Tiles" type="HBoxContainer" parent="Summary/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="EhpTile" parent="Summary/VBox/Tiles" instance=ExtResource("4_tile")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.6
caption = "Effective health"
main_tile = true

[node name="MaxHitTile" parent="Summary/VBox/Tiles" instance=ExtResource("4_tile")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
caption = "Maximum hit taken"

[node name="HitsTile" parent="Summary/VBox/Tiles" instance=ExtResource("4_tile")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
caption = "Hits to die"

[node name="TakenTile" parent="Summary/VBox/Tiles" instance=ExtResource("4_tile")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
caption = "Damage taken"

[node name="Scroll" type="ScrollContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Sections" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="ParamsPanel" type="PanelContainer" parent="Scroll/Sections"]
layout_mode = 2
theme_type_variation = &"SectionCard"

[node name="ParamsContent" type="VBoxContainer" parent="Scroll/Sections/ParamsPanel"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="ParamsTitle" type="Label" parent="Scroll/Sections/ParamsPanel/ParamsContent"]
layout_mode = 2
theme_type_variation = &"SectionTitle"
text = "Fight parameters"

[node name="ParamsHint" type="Label" parent="Scroll/Sections/ParamsPanel/ParamsContent"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Empowered monoliths and pinnacle bosses are area level 100. Corruption is the same value as on the \"Conditions\" tab: it raises boss hit damage by 1%·f(c) and damage over time by 0.5%·f(c)."
autowrap_mode = 3

[node name="Inputs" type="GridContainer" parent="Scroll/Sections/ParamsPanel/ParamsContent"]
layout_mode = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 6
columns = 8

[node name="AreaLevelLabel" type="Label" parent="Scroll/Sections/ParamsPanel/ParamsContent/Inputs"]
layout_mode = 2
tooltip_text = "Enemy penetration (1% per level, max 75%) and the level used by the armor, dodge and block formulas"
mouse_filter = 1
text = "Area level"

[node name="AreaLevelSpin" type="SpinBox" parent="Scroll/Sections/ParamsPanel/ParamsContent/Inputs"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 0)
layout_mode = 2
tooltip_text = "Enemy penetration (1% per level, max 75%) and the level used by the armor, dodge and block formulas"
min_value = 1.0
max_value = 100.0
step = 1.0
update_on_text_changed = true

[node name="CorruptionLabel" type="Label" parent="Scroll/Sections/ParamsPanel/ParamsContent/Inputs"]
layout_mode = 2
tooltip_text = "Enemy corruption, shared with the Conditions tab"
mouse_filter = 1
text = "Corruption"

[node name="CorruptionSpin" type="SpinBox" parent="Scroll/Sections/ParamsPanel/ParamsContent/Inputs"]
