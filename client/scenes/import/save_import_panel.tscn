[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/import/save_import_panel.gd" id="1_script"]

[node name="SaveImportPanel" type="VBoxContainer"]
theme_override_constants/separation = 8
script = ExtResource("1_script")

[node name="Title" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Import a character from a save file"

[node name="Hint" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Analyse a build from the offline character file of the game. One file is one character. The current build will be replaced."
autowrap_mode = 3

[node name="PathHint" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "On Windows the files are in this folder; they are named like 1CHARACTERSLOT_BETA_0 or CHARACTERSLOT_BETA_n (stash files cannot be imported):"
autowrap_mode = 3

[node name="PathEdit" type="LineEdit" parent="."]
unique_name_in_owner = true
layout_mode = 2
