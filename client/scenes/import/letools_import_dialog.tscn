[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/import/letools_import_dialog.gd" id="1_script"]
[ext_resource type="Theme" path="res://theme/main_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/import/maxroll_import_panel.tscn" id="3_maxroll"]
[ext_resource type="PackedScene" path="res://scenes/import/save_import_panel.tscn" id="4_save"]

[node name="LEToolsImportDialog" type="Window"]
title = "Import a build"
initial_position = 1
size = Vector2i(760, 720)
visible = false
transient = true
exclusive = true
min_size = Vector2i(480, 360)
theme = ExtResource("2_theme")
script = ExtResource("1_script")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="Layout" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SourceTabs" type="TabContainer" parent="Panel/Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
current_tab = 0

[node name="MaxrollPanel" parent="Panel/Margin/Layout/SourceTabs" instance=ExtResource("3_maxroll")]
unique_name_in_owner = true
layout_mode = 2
metadata/_tab_index = 0

[node name="LEToolsPanel" type="VBoxContainer" parent="Panel/Margin/Layout/SourceTabs"]
visible = false
layout_mode = 2
theme_override_constants/separation = 8
metadata/_tab_index = 1

[node name="Title" type="Label" parent="Panel/Margin/Layout/SourceTabs/LEToolsPanel"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Import a build from lastepochtools.com"

[node name="Hint" type="Label" parent="Panel/Margin/Layout/SourceTabs/LEToolsPanel"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Paste the planner link (or just its code). You can also paste a ready planner_data JSON response, then no network request is made. The current build will be replaced."
autowrap_mode = 3

[node name="SiteRow" type="HBoxContainer" parent="Panel/Margin/Layout/SourceTabs/LEToolsPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="OpenSiteButton" type="Button" parent="Panel/Margin/Layout/SourceTabs/LEToolsPanel/SiteRow"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Open the LE Tools planner"
tooltip_text = "https://www.lastepochtools.com/planner/"

[node name="SiteHint" type="Label" parent="Panel/Margin/Layout/SourceTabs/LEToolsPanel/SiteRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
text = "There: Import → account and character name → copy the page address here."
autowrap_mode = 3

[node name="LinkRow" type="HBoxContainer" parent="Panel/Margin/Layout/SourceTabs/LEToolsPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="LinkEdit" type="LineEdit" parent="Panel/Margin/Layout/SourceTabs/LEToolsPanel/LinkRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "https://www.lastepochtools.com/planner/…"
clear_button_enabled = true

[node name="LoadButton" type="Button" parent="Panel/Margin/Layout/SourceTabs/LEToolsPanel/LinkRow"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Load"

[node name="StatusScroll" type="ScrollContainer" parent="Panel/Margin/Layout/SourceTabs/LEToolsPanel"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="StatusLabel" type="Label" parent="Panel/Margin/Layout/SourceTabs/LEToolsPanel/StatusScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3

[node name="SavePanel" parent="Panel/Margin/Layout/SourceTabs" instance=ExtResource("4_save")]
unique_name_in_owner = true
visible = false
layout_mode = 2
metadata/_tab_index = 2

[node name="ButtonRow" type="HBoxContainer" parent="Panel/Margin/Layout"]
layout_mode = 2
alignment = 2

[node name="CloseButton" type="Button" parent="Panel/Margin/Layout/ButtonRow"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Close"

[node name="Http" type="HTTPRequest" parent="."]
unique_name_in_owner = true
timeout = 30.0

[node name="RetryTimer" type="Timer" parent="."]
unique_name_in_owner = true
wait_time = 3.0
one_shot = true
