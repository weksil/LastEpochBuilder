[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/config/config_tab.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/config/ailment_row.tscn" id="2_row"]

[node name="Conditions" type="ScrollContainer"]
horizontal_scroll_mode = 0
script = ExtResource("1_script")
ailment_row_scene = ExtResource("2_row")

[node name="Root" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="TopBar" type="HBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="ShowAllCheck" type="CheckBox" parent="Root/TopBar"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Show all conditions"
tooltip_text = "Off: only the conditions your build depends on (and already enabled ones) are shown."

[node name="Hint" type="Label" parent="Root/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
text = "Only conditions with a source in the build are shown: skills, items, passives. Enabled conditions are always visible."
autowrap_mode = 3

[node name="EmptyHint" type="Label" parent="Root"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"SummaryOff"
text = "No conditions that the build depends on: no skill, item or passive uses player states or enemy ailments. \"Show all conditions\" opens the full list."
autowrap_mode = 3

