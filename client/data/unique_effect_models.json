{
 "gameVersion": "1.5.0",
 "source": "Hand-written client planner models (not extracted data; lives in client/data) for unique special effects (PlayerProperty / AbilityProperty), derived from unique_effects.json formulas (research/07i_unique_formulas.md). Only effects that reduce to a stat of the character or of one skill are modelled.",
 "schema": {
  "player": "ppIndex -> model; the mod value pp comes from the unique's mod with property 98 (PlayerProperty) and tags == ppIndex",
  "ability": "'abilityIndex:propertyIndex' -> model; pp comes from the mod with property 58 (AbilityProperty), tags == abilityIndex, specialTag == propertyIndex; applied only to the skill whose abilityIDEnum.value == abilityIndex",
  "model.stat": "SP name (sp_enum.json); mod: added|increased|more; tags: AT names joined by '|'; ailment: AilmentID name used as specialTag",
  "model.value": "pp * clamp(source, 0, src_max) - offset ... exactly: x = pp * (source - offset) * factor, then clamped to [min, max]; without 'per' x = pp * factor",
  "model.per": "attr:str|vit|int|dex|att, total_attr, added:<SP>, value:<SP>, increased:<SP>, added_exact:<SP>:<AT mask>, res:<damage type 0..6> (uncapped), ele_res, total_res, max_health, max_mana, endurance_threshold, enemy_stacks:<Ailment>, player:<number key>, complete_sets",
  "model.at_least / below": "{per, value}: the model applies only if the source is >= value (at_least) or < value (below)",
  "model.when": "all must hold: enemy:<Ailment> (has stacks), enemy_any:<A>|<B>, enemy_flag:<flag>, enemy:boss_or_rare, player:<flag>, player:!<flag>, gear:dual_wield, gear:two_handed_melee, slot:<slot>",
  "model.skill_any": "skill-local: applies only to skills having any of these tags",
  "model.kind": "stat (default) | mana_added (skill mana cost) | overcap_taken (Null Portent: per damage type, needs cap_pp)",
  "model.note": "assumption shown to the user"
 },
