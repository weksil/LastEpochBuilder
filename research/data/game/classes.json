 "formulas": {
  "Health": "RoundHalfEven((baseHealth + L*healthPerLevel + ΣaddedHealth) * (1+Σinc) * Π(1+more))",
  "Mana": "RoundHalfEven((baseMana + L*manaPerLevel + Σadded) * (1+Σinc) * Πmore)",
  "HealthRegen": "(healthRegen + L*healthRegenPerLevel + Σadded) * (1+Σinc) * Πmore",
  "StunAvoidance": "baseStunAvoidance + L*stunAvoidancePerLevel (+ mods)",
  "EnduranceThreshold": "(1+inc76)*((maxMore96 + enduranceThresholdPerHealth + A96)*maxHealth + baseEnduranceThreshold + L*enduranceThresholdPerLevel + A76)*more76",
  "MinionDamageMore": "L >= first ? (L-first+1)*moreMinionDamagePerLevel : 0   (tags Minion)",
  "MinionDamageTakenMore": "L >= first ? -(L-first+1)*lessMinionDamageTakenPerLevel : 0   (tags Minion)",
  "levelMultiplier": "L (not L-1): SetInitialValues calls onLevelChange(0, L)"
 },
