{
 "gameVersion": "1.5.0",
 "skill": "Holy Aura (AbilityID 187 holyAura, tree ah443, HolyAuraTree)",
 "sources": [
  "dump/decomp/LE.dll/HolyAuraMutator.c + ISIL HolyAuraMutator.txt (.ctor, Mutate, OnMutatorUpdate)",
  "AuraMutator ISIL (.cctor, Mutate)",
  "HolyAuraTree.updateMutator",
  "BuffOnAllyHit.Apply/addBuffToList",
  "StatBuffs.addBuff(Buff)",
  "Buff.generateName",
  "AbilityStatsMutatorManager.UpdateAbilityStats case 0xBB",
  "KnightTree.updateMutator (passives)",
  "prefab typetrees via UnityPy (HolyAura, Aura, mutators)"
 ],
 "constants": {
  "auraStatsMultiplier_k": 2.0,
  "auraStatsMultiplier_note": "HolyAuraMutator..ctor writes 0x40000000; prefab serialises 2.0; HolyAuraTree.updateMutator writes 0x40000000 again. No other writer.",
  "HolyAuraTree_copy_multiplier": 2.0,
  "HolyAuraTree_copy_note": "hard-coded 0x40000000 (NOT read from auraStatsMultiplier)",
  "castInterval_s": 0.5,
  "castInterval_src": "HolyAuraMutator..ctor +0x1A4 = 0x3F000000",
  "passiveHolyAuraDuration_s": 4.0,
  "passiveHolyAuraDuration_src": "HolyAuraMutator..ctor +0x158 = 0x40800000 (= basePassiveHolyAuraDuration/MAX_BUFF_DURATION const 4)",
  "passiveAuraBuffDuration_s": 4.0,
  "passiveAuraBuffDuration_src": "AuraMutator.Mutate passes constant 4.0 (0x184561DD4) as duration to every addBuffToList",
  "activeBuffDuration": "clamp(boostDuration - timeSinceActiveCast + castInterval + 0.1, castInterval + 0.1, 4.0), boostDuration=(1+increasedBoostDuration)*4",
  "boostDurationBase_s": 4.0,
  "boostDurationWithConcentration_s": 6.0,
  "auraRadius_m": 20.0,
  "auraRadius_src": "SphereCollider radius 20 (trigger), scale 1, on prefabs HolyAura (active) and Aura (passive, AbilityID 190); AuraMutator.increasedRadius is dead",
  "hitDetector": {
   "ignoreCreator": false,
   "canApplyToSameAllyAgain": false,
   "objectLifetime_s": 1.0
  },
  "cooldown_base_s": 10.0,
  "manaCost": 30.0,
  "instantCastForPlayer": true,
  "buffNameFormat": "Buff.generateName(identifier, stat) = format(identifier, SP, AT, specialTag, extraTag, added>0, increased>0); same name on the same actor REPLACES the old buff (StatBuffs.addBuff(Buff) -> removeBuffsWithName)",
  "identifiers": {
   "defaults": "default aura mutator",
   "tree_and_most_extras": "aura mutator",
   "mana_regen_extra": "extra aura mutator",
   "personal_flame_burst": "Aura Personal Flame Burst"
  },
  "flameBurstBaseStacks": 9,
  "flameBurstBaseStacks_src": "AuraMutator.baseFieryInquisitionStacksOnMeleeHit const 9 (0x184561DD8)"
 },
 "defaultStats": [
  {
   "sp": "ElementalResistance",
   "spId": 52,
   "kind": "added",
   "tags": "None",
   "value": 0.15,
   "src": "AuraMutator..cctor, const 0x18471CD50"
  },
  {
   "sp": "Damage",
   "spId": 0,
   "kind": "increased",
   "tags": "None",
   "value": 0.3,
   "src": "AuraMutator..cctor, const 0x184561DBC"
  }
 ],
 "X": {
  "definition": "X = mgr.holyAuraIncreasedEffect(+0x114C) + increasedEffectFromPassives; M = 1 + X (additive inside, multiplicative on the stat)",
  "mgr.holyAuraIncreasedEffect": "sum of the added value of every AbilityPropertyStat(ability 187 holyAura, index/specialTag 0) on the caster. Only source found in 1.5.0 data: Paladin passive \"Paladin Covenant\" (Covenant of Light) +0.04 per point, max 5 -> +0.20. No affix/unique/idol/blessing/weaver writes it.",
  "increasedEffectFromPassives": "HolyAuraMutator(+0x140)/AuraMutator(+0x134): written by KnightTree.updateMutator = 0.1 * points of \"Paladin Increased Holy Aura Effectiveness\" - a node name that does NOT exist in the tree data (code_node_names_not_in_tree). Effective value 0 in 1.5.0. Holy Aura tree does not write it.",
  "applies_to": "passive: defaults, tree stats, mana regen, block/Str, movespeed, stun avoidance. active: same plus health regen (active) and immunity property. Does NOT apply to personal flame-burst buff, ward on activation, slow chance, health globe, cleanse."
 },
 "pipeline": {
  "passive_AuraMutator.Mutate": {
   "when": "HolyAuraMutator.OnMutatorUpdate every castInterval=0.5 s, ability present, and NOT inside the boost window; skipped if inactiveWhileOnCooldown && Holy Aura on cooldown. Spawns an Aura object (ability 190) at the caster; sphere r=20 hits allies incl. the caster.",
   "duration_s": 4.0,
   "buffs": [
    "defaults (not if disableDefaultStats): value_default * M",
    "AuraMutator.statsToApply (raw node stats): v * M",
    "mana regen: IncreasedStat(ManaRegen, mgr.holyAuraIncManaRegen) * M   [name extra aura mutator]",
    "block effectiveness: AddedStat(BlockEffectiveness, Strength*mgr.holyAuraBlockEffectivenessPerStrength) * M",
    "movespeed: IncreasedStat(Movespeed, mgr.holyAuraIncreasedMovespeed) * M",
    "stun avoidance: IncreasedStat(StunAvoidance, mgr.holyAuraIncreasedStunAvoidance) * M",
    "holyAuraPersonalMinionsOnly -> BuffOnAllyHit.onlyApplyToCreatorsMinions (caster itself excluded)"
   ],
   "caster_only": "canFlameBurst: personal buff AilmentChanceStat(HolyAuraStackForFlameBurst, Melee) = 9 + addedStacks, 4 s, no M"
  },
  "active_HolyAuraMutator.Mutate": {
   "when": "player casts Holy Aura (isRecastOfActive=false, timeSinceActiveCast:=0) and OnMutatorUpdate re-casts the active object every 0.5 s while timeSinceActiveCast <= (1+increasedBoostDuration)*4 (isRecastOfActive=true). In that window the passive object is NOT cast, the active buffs (same names) replace the passive ones.",
   "duration_s": "clamp(boost - timeSince + 0.6, 0.6, 4.0)",
   "buffs": [
    "defaults: value_default * k * M  (k=2.0) -> ER 0.30, Damage inc 0.60 (times M)",
    "HolyAuraMutator.statsToApply (tree copy already x2): (2v) * M   - NOT multiplied by k again",
    "mana regen: holyAuraIncManaRegen * k * M",
    "block effectiveness: Strength*perStr * k * M",
    "movespeed: holyAuraIncreasedMovespeed * k * M",
    "stun avoidance: holyAuraIncreasedStunAvoidance * k * M",
    "health regen (active only): AddedStat(HealthRegen, mgr.holyAuraHealthRegenInActiveMode) * M  (NO k)",
    "slow/chill immunity (mgr.holyAuraActiveSlowImmune or ...ChillImmune): PlayerProperty 450 = 1.0 * M (boolean in effect)"
   ],
   "caster_only": "canFlameBurst: AilmentChanceStat(HolyAuraStackForFlameBurst, Melee) = k*9 + addedStacks, duration = clamped buff duration, no M",
   "first_cast_only": [
    "wardGainedOnActivation (GiveResourcesOnHit.wardOnHit)",
    "activeCleanse (CleanseAilmentsOnHit all negatives)",
    "mgr.holyAuraMoreIgniteDamageOnActivation: AmplifyDamageOfAilmentOfType(Ignite, value, onlyFromSpecificActor=caster) on enemies with Ignite and Manhattan distance < 20 from caster"
   ],
   "every_tick": [
    "mgr.holyAuraElectrifyChancePerSecondPerAttunement: RepeatedlyApplyAilmentsInRadius (r=10 m) chance = Attunement*value*castInterval",
    "slow chance chanceToSlowEnemiesEverySecond*castInterval",
    "fear (mgr flag) r=10 m",
    "blind (mgr flag)",
    "reset evade/traversal cooldowns (mgr flag)"
   ]
  },
  "application_to_actor": "BuffOnAllyHit.Apply -> for each Buff: new Buff(copy, duration) -> StatBuffs.addBuff(Buff): removes buffs of the same name, adds the buff, stat is added to the actor Stats as an ordinary stat (no further multiplier). Refreshed every 0.5 s.",
  "name_collisions": "Names collide when identifier+SP+tags+specialTag+extraTag+(added>0)+(increased>0) are equal. Active replaces passive by design. Edge: mgr block-per-Strength extra (AddedStat BlockEffectiveness tags 0) has the same name as tree node Mighty Shield BlockEffectiveness and is added later in the list -> it REPLACES (does not add to) the tree value."
 },
